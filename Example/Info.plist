<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the keys the build settings generate. The edge's install page opens matcaedge://pair?… to pair
     this phone with a model; the app uses only the system's HTTPS, which needs no export documentation. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.matca.edge.example.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>matcaedge</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
